# Supabase Configuration
# Obtain these values from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# LLM / AI Configuration for AG-001 Resume Analysis Agent (Server-Only Secret Key)
# Provide your Gemini API key in .env.local (Server-side secret, NOT exposed to browser)
GEMINI_API_KEY=your_gemini_api_key_here

# Experiential Labs Configuration for GPT-6 Astra LLM Provider (Server-Only Secret Key)
# Provide your Experiential Labs API key in .env.local (Server-side secret, NOT exposed to browser)
EXPLABS_API_KEY=your_experiential_labs_api_key_here

# Job Search API Configuration for AG-002 Job Search Agent (Server-Only Secret Key)
# Provide your RapidAPI / JSearch API key in .env.local (Server-side secret, NOT exposed to browser)
RAPIDAPI_KEY=your_rapidapi_key_here

# OAuth Redirect URL Configuration in Supabase Dashboard -> Authentication -> URL Configuration:
# Site URL: http://localhost:3000
# Redirect URLs: http://localhost:3000/auth/callback, http://localhost:3000/auth/reset-password
